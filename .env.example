# DeepSeek API（API Key 需要在 DeepSeek 平台申请）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
DEEPAGENTS_MODEL=openai:deepseek-flash

# LangSmith 追踪（可选，填入 API Key 后改为 true）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lung-agent

AGENT_SERVICE_PORT=8010
AGENT_BIND_HOST=127.0.0.1
AGENT_STORAGE_PATH=./storage

# FHIR MCP 服务（Docker 内默认访问宿主机 8001 端口）
FHIR_MCP_URL=http://127.0.0.1:8001/mcp
MCP_BEARER_TOKEN=
FHIR_MCP_HOST_HEADER=localhost:8001
